[internationalization]

locale/translations=PackedStringArray("res://data/strings.en.translation", "res://data/strings.ru.translation", "res://data/strings.ro.translation")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.8, 0.98, 1)
