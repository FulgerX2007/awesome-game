class_name WinterData
extends RefCounted
## The game data of Долгая зима, loaded once from the resources in data/ (generated by
## tools/winter-godot/data.cjs) and handed to the rules in the shape core.js uses:
##   WinterData.tables().TOOLS.pick.cost, .HUT_STAGES[1].cost, .FOOD.cookedMeat, .BEAR.hp ...
## The view reads the definitions themselves (names, descriptions) through items(), recipes(), buildings(), survivors().

const BALANCE := "res://data/balance.tres"
const ITEMS := "res://data/items.tres"
const RECIPES := "res://data/recipes.tres"
const BUILDINGS := "res://data/buildings.tres"
const SURVIVORS := "res://data/survivors.tres"

static var _tables: Dictionary = {}


static func balance() -> WinterBalance:
	return load(BALANCE) as WinterBalance


static func items() -> Array:
	return (load(ITEMS) as WinterCatalog).entries


static func recipes() -> Array:
	return (load(RECIPES) as WinterCatalog).entries


static func buildings() -> Array:
	return (load(BUILDINGS) as WinterCatalog).entries


static func survivors() -> Array:
	return (load(SURVIVORS) as WinterCatalog).entries


## A definition by id from one of the catalogs above (null when there is none).
static func find(list: Array, id: String) -> Resource:
	for d in list:
		if d.id == id:
			return d
	return null


## Every table of the rules, built once. Plain dictionaries and arrays (deep copies of the resources),
## so nothing the rules hold can change the loaded resources.
static func tables() -> Dictionary:
	if not _tables.is_empty():
		return _tables
	var b := balance()
	var t := {}
	for p in b.get_property_list():
		if p.usage & PROPERTY_USAGE_SCRIPT_VARIABLE:
			var v = b.get(p.name)
			t[p.name.to_upper()] = v.duplicate(true) if v is Dictionary or v is Array else v
	var res: Array = []
	var food := {}
	for it in items():
		if it.kind == "material":
			res.append(it.id)
		else:
			food[it.id] = it.food
	t.RES = res
	t.FOOD = food
	t.FOOD_ITEMS = food.keys()
	t.ITEMS = res + food.keys()
	var tools := {}
	var gear := {}
	for r in recipes():
		if r.kind == "tool":
			tools[r.id] = {cost = r.cost.duplicate(true)}
		else:
			gear[r.id] = {name = r.core_name, cost = r.cost.duplicate(true)}
	t.TOOLS = tools
	t.GEAR = gear
	t.GEAR_IDS = gear.keys()
	var stages: Array = []
	var upgrades := {}
	for d in buildings():
		match d.kind:
			"hut":
				stages.append({id = d.id, cost = d.cost.duplicate(true)})
			"palisade":
				t.PALISADE_COST = d.cost.duplicate(true)
				t.PALISADE_REPAIR = d.repair.duplicate(true)
			"bunk":
				t.BUNK_COST = d.cost.duplicate(true)
			"upgrade":
				upgrades[d.id] = {name = d.core_name, cost = d.cost.duplicate(true)}
	t.HUT_STAGES = stages
	t.UPGRADES = upgrades
	t.UPGRADE_IDS = upgrades.keys()
	var sv := {}
	var work := {}
	for s in survivors():
		sv[s.id] = {name = s.name, x = s.x, y = s.y, need = s.need}
		work[s.id] = {every = s.work_every, give = s.work_give.duplicate(true)}
	t.SURVIVORS = sv
	t.SURVIVOR_IDS = sv.keys()
	t.WORK = work
	_tables = t
	return t
