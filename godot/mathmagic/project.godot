; MathMagic: Island of Addition. Open this folder in Godot 4.7, or build with tools/mathmagic/build.sh.

config_version=5

[application]

config/name="MathMagic"
config/description="A 2.5D math adventure for children aged 6-10: count, add and subtract to build bridges, open gates and calm the Stone Guardian."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.35, 0.7, 0.95, 1)

[autoload]

ProgressManager="*res://scripts/progression/progress_manager.gd"
MathChallengeManager="*res://scripts/math/math_challenge_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/GolosText.ttf"

